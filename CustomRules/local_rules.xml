<!-- This rule detect repetition of attack web returned 200 source from 1 ip -->
<group name="repeated,attack,sameip">
  <rule id="100600" level="8" frequency="20" timeframe="60">
    <if_matched_sid>31106</if_matched_sid>
    <same_srcip />
     <description>Attack web code 200 more than 20 in 1 second</description>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>
</group>

<!-- This rule detect possible remote file inclusion-->
<group name="web,attack,appsec">
  <rule id="100700" level="12">
    <!--<if_group>web</if_group>-->
    <if_sid>31100</if_sid>
    <match type="pcre2">(?i)\?[^=]+=(https?|ftp)://</match>
    <description>Possible remote file inclusion from query parameters</description>
    <mitre>
      <id>T1190</id>
    </mitre>
   </rule>
</group>

<!-- This rule detect xss combined with csrf to create new administrator-->
<group name="web,attack,xss,csrf">
  <rule id="100701" level="13">
    <!--<if_group>web</if_group>-->
    <if_sid>31108</if_sid>
    <match type="pcre2">POST /wp-admin/(user-new\.php|users\.php).*wp-admin/admin\.php[?]page=</match>
    <!--<match type="pcre2">(?i)wp-admin/admin\.php[?]page=</match>-->
    <description>Unauthenticated User Creation via CSRF detected</description>
    <mitre>
      <id>T1059.007</id>
      <id>T1078.002</id>
    </mitre>
   </rule>
</group>
